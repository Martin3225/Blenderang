; Blenderang test project. The runner copies it to tests/.work/project
; and adds the add-on from the repo and Terrain3D, so the fixtures never change.

config_version=5

[application]

config/name="BlenderangTests"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/blenderang/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/bb_test_driver/plugin.cfg")

[filesystem]

import/blender/enabled=false
